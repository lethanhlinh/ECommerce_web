@model IEnumerable<ProductModel>
@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .col-sm-3 {
        padding: 0 15px;
    }

    .col-sm-9 {
        padding: 0 15px;
    }

    .features_items {
        margin-top: 30px;
        padding: 0 15px;
    }

    .title {
        font-size: 28px;
        color: #333;
        margin-bottom: 30px;
        font-weight: bold;
    }

    .product-image-wrapper {
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 15px;
        background-color: #fff;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }

        .product-image-wrapper:hover {
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
        }

    .single-products {
        position: relative;
        text-align: center;
    }

    .productinfo img {
        max-width: 100%;
        border-radius: 5px;
        height: auto;
        object-fit: cover;
    }

    .productinfo h2 {
        font-size: 20px;
        color: #333;
        font-weight: bold;
        margin: 15px 0;
    }

    .productinfo p {
        font-size: 14px;
        color: #666;
    }

    .btn {
        border-radius: 5px;
        font-size: 14px;
        padding: 10px 20px;
        margin-top: 10px;
        background-color: #007bff;
        color: #fff;
        transition: background-color 0.3s ease;
    }

        .btn:hover {
            background-color: #0056b3;
        }

    .choose {
        margin-top: 15px;
    }

    .nav-pills {
        list-style: none;
        padding-left: 0;
        display: flex;
        justify-content: center;
    }

        .nav-pills li {
            margin-right: 10px;
        }

        .nav-pills a {
            font-size: 14px;
            color: #007bff;
            text-decoration: none;
            display: flex;
            align-items: center;
        }

            .nav-pills a:hover {
                color: #0056b3;
            }

        .nav-pills i {
            margin-right: 5px;
        }

    .btn-default {
        background-color: #f8f9fa;
        color: #6c757d;
    }

        .btn-default:hover {
            background-color: #e2e6ea;
        }

    .add-to-cart {
        background-color: #28a745;
    }

        .add-to-cart:hover {
            background-color: #218838;
        }

    .product-image-wrapper {
        margin-bottom: 30px;
        height: 550px;
    }

    .padding-right {
        padding-right: 30px;
    }

    .col-sm-4 {
        padding-left: 15px;
        padding-right: 15px;
    }

</style>

<partial name = "_SliderPartial" />
<div class="col-sm-3">
	<partial name="_SidebarPartial" />
</div>

<div class="col-sm-9 padding-right">
	<div class="features_items">
		<!--features_items-->
		<h2 class="title text-center">Features Items</h2>
		@foreach(var item in Model){
			<div class="col-sm-4">
				<div class="product-image-wrapper">
					<div class="single-products">

						<div class="productinfo text-center">
							<a asp-action = "Details" asp-controller = "Product" asp-route-Id = "@item.Id">
								<img src="~/media/products/@item.Image" alt="@item.Name" width="auto" height="200px"/>
								<h2>$@item.Price.ToString("#,##0 VND")</h2>
								<p>Danh mục : @item.Category.Name</p>
								<p>Thương hiệu : @item.Brand.Name</p>
							</a>
							@*		<a class="btn btn-default add-to-cart" asp-action="Add" asp-controller="Cart" asp-route-Id="@item.Id"><i class="fa fa-shopping-cart"></i>Add to cart</a>*@	
							@if(item.Quantity>0){
								<button class="btn btn-default add-to-cart" data-product_id="@item.Id"><i class="fa fa-shopping-cart"></i>Thêm vào giỏ hàng</button>
							}
							else
							{
								<button class="btn btn-default "><i class="fa fa-shopping-cart"></i>Hết hàng</button>
							}
						</div>
						
					</div>
				<div class="choose">
						@if (User.Identity?.IsAuthenticated ?? false)
						{
					<ul class="nav nav-pills nav-justified">
								<li><button class="btn btn-danger add-btn-wishlist" data-product_id="@item.Id" style="margin-left: 60px;">Yêu thích</button></li>
								<li><button class="btn btn-primary add-btn-compare" data-product_id="@item.Id" style="">So sánh</button></li>
					</ul>
						}
				</div>
			</div>
		</div>
		}
	</div><!--features_items-->
</div>
@section Scripts {
	<script>
		$(document).ready(function(){
			$('.add-to-cart').click(function(){
				var Id = $(this).data("product_id");

				// alert(product_id);
				$.ajax({
					type: "POST",
					url: "@Url.Action("Add","Cart")",
					data: {Id: Id},

					success: function(result){
					if(result) {
						Swal.fire("Thêm vào giỏ hàng thành công.");
					}
					}
				});
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('.add-btn-wishlist').click(function () {
				var Id = $(this).data("product_id");

				// alert(product_id);
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddWishlist", "Home")",
					data: { Id: Id },

					success: function (result) {
						if (result) {
							Swal.fire("Thêm yêu thích thành công.");
						}
					}
				});
			});
		});
	</script>



	<script>
		$(document).ready(function () {
			$('.add-btn-compare').click(function () {
				var Id = $(this).data("product_id");

				// alert(product_id);
				$.ajax({
					type: "POST",
					url: "@Url.Action("AddCompare", "Home")",
					data: { Id: Id },

					success: function (result) {
						if (result) {
							Swal.fire("Thêm so sánh sản phẩm thành công.");
						}
					}
				});
			});
		});
	</script>
}
