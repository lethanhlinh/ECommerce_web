@model ContactModel


@if (Model != null)
{

	<div class="row">
		<div class="col-sm-2">
			<div class="companyinfo">
				<p><img src="~/media/logo/@Model.LogoImg" width="150px" height="100px" /></p>
				<p>@Html.Raw(Model.Description)</p>
			</div>
		</div>
		<div class="col-sm-7">
			<div class="col-sm-4">
				<div class="video-gallery text-center">
					<a href="#">
						<div class="iframe-img">
							<img src="~/images/ft1.png" alt="" />
						</div>
						<div class="overlay-icon">
							<i class="fa fa-play-circle-o"></i>
						</div>
					</a>
					<p>Circle of Hands</p>
					<h2>24 DEC 2014</h2>
				</div>
			</div>

			<div class="col-sm-4">
				<div class="video-gallery text-center">
					<a href="#">
						<div class="iframe-img">
							<img src="~/images/ft2.png" alt="" />
						</div>
						<div class="overlay-icon">
							<i class="fa fa-play-circle-o"></i>
						</div>
					</a>
					<p>Circle of Hands</p>
					<h2>24 DEC 2014</h2>
				</div>
			</div>

			<div class="col-sm-4">
				<div class="video-gallery text-center">
					<a href="#">
						<div class="iframe-img">
							<img src="~/images/ft3.png" alt="" />
						</div>
						<div class="overlay-icon">
							<i class="fa fa-play-circle-o"></i>
						</div>
					</a>
					<p>Circle of Hands</p>
					<h2>24 DEC 2014</h2>
				</div>
			</div>
		</div>
		<div class="col-sm-3">
			@Html.Raw(Model.Map)
		</div>
	</div>
}
else
{
    <p>Chưa có thông tin liên hệ nào được cung cấp.</p>
}
