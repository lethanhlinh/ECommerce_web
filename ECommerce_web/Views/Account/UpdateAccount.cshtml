@model AppUserModel
@{
	ViewData["Title"] = "Update Account Information";
}
<style>
    body {
        font-family: 'Arial', sans-serif;
        background-color: #f4f7fa;
        margin: 0;
        padding: 0;
    }

    h3 {
        font-size: 24px;
        color: #333333;
        text-align: center;
        margin-bottom: 20px;
    }

    .col-md-9 {
        margin: 0 auto;
        background-color: #ffffff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        font-size: 14px;
        font-weight: bold;
        color: #555555;
    }

    .form-control {
        border: 1px solid #cccccc;
        border-radius: 5px;
        padding: 10px;
        font-size: 14px;
        width: 100%;
        background-color: #f9f9f9;
    }

    .form-control[readonly] {
        background-color: #e9ecef;
        cursor: not-allowed;
    }

    .btn {
        background-color: #007bff;
        color: #ffffff;
        padding: 10px 20px;
        font-size: 16px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .btn:hover {
        background-color: #0056b3;
    }

    .text-danger {
        color: #d9534f;
        font-size: 12px;
    }

    input[type="text"]:required {
        border: 1px solid #ffb3b3;
    }

    input[type="text"]:focus {
        border-color: #007bff;
        outline: none;
    }


</style>

<h3>Update Account Information</h3>
<div class="col-md-9">
	<form autocomplete="off" asp-action="UpdateInfoAccount" asp-controller="Account" method="post" >
			<input type="hidden" asp-for="Id"/>

					<div asp-validation-summary="ModelOnly" class="text-danger"></div>
					
						<div class="form-group">
							<label>Username</label>
							<input asp-for="UserName" readonly required class="form-control" />
							<span asp-validation-for="UserName" class="text-danger" />
						</div>
						<div class="form-group">
							<label>Email</label>
							<input asp-for="Email" readonly required class="form-control" />
							<span asp-validation-for="Email" class="text-danger" />
						</div>
						<div class="form-group">
							<label>Phone Number</label>
							<input asp-for="PhoneNumber" required class="form-control" />
							<span asp-validation-for="PhoneNumber" class="text-danger" />
						</div>
						<div class="form-group">
							<label> Old Password</label>
							<input type="text" readonly value="@Model.PasswordHash" class="form-control" />
							
						</div>

						<div class="form-group">
							<label> New Password</label>
							<input type="text" name="PasswordHash" required class="form-control" />
							<span asp-validation-for="PasswordHash" class="text-danger" />
						</div>
						<div class="form-group">
							<button class="btn btn-primary">Update</button>
						</div>
	</form>
</div>
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}