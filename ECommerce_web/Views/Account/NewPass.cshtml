@model AppUserModel
@{
	ViewData["Title"] = "Get a new Password";
}
<style>
    body {
        font-family: 'Arial', sans-serif;
        background-color: #eef2f7;
        margin: 0;
        padding: 0;
    }

    .container {
        margin-top: 50px;
    }

    .login-form {
        background-color: #ffffff;
        border-radius: 10px;
        padding: 30px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

        .login-form h2 {
            font-size: 24px;
            font-weight: bold;
            color: #333333;
            margin-bottom: 20px;
            text-align: center;
        }

    .form-group label {
        font-size: 14px;
        font-weight: bold;
        color: #555555;
    }

    .form-control {
        border: 1px solid #cccccc;
        border-radius: 5px;
        padding: 10px;
        font-size: 14px;
        width: 100%;
        margin-bottom: 10px;
    }

        .form-control[readonly] {
            background-color: #f9f9f9;
            color: #666666;
            cursor: not-allowed;
        }

    .btn {
        background-color: #5cb85c;
        color: #ffffff;
        padding: 10px 20px;
        font-size: 16px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

        .btn:hover {
            background-color: #4cae4c;
        }

    a {
        text-decoration: none;
    }

        a:hover {
            text-decoration: underline;
        }

        a[style*="color: red;"] {
            font-weight: bold;
        }

    .text-danger {
        color: #d9534f;
    }

    p {
        text-align: center;
        margin-top: 10px;
    }

        p i {
            font-size: 14px;
            color: #606065;
        }
</style>

<section id="">
	<!--form-->
	<div class="container">
		<div class="row">
			<div class="col-sm-8 col-sm-offset-1">
				<div class="login-form">
					<!--login form-->
					<h2>Đặt mật khẩu mới</h2>
					<div asp-validation-summary="ModelOnly" class="text-danger"></div>
					<form asp-action="UpdateNewPassword" asp-controller="Account">
						<input type="hidden" name="token" value="@ViewBag.Token" />
						<div class="form-group">
							<label>Email</label>
							<input asp-for="Email" readonly value="@ViewBag.Email" class="form-control" />
							<span asp-validation-for="Email" class="text-danger" />
						</div>

						<div class="form-group">
							<label>Password</label>
							<input asp-for="PasswordHash" class="form-control" />
							<span asp-validation-for="PasswordHash" class="text-danger" />
						</div>

						<button class="btn btn-default">Send</button>
						<p style="margin-top: 20px; font-size: 16px;"><i style="color: #606065;">Bạn chưa có tài khoản? </i> <a asp-action="Create" asp-controller="Account" style="color: red;">Đăng ký</a></p>

					</form>
				</div><!--/login form-->
			</div>
		</div>
	</div>
</section><!--/form-->
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}