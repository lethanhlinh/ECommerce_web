@model UserModel
@{
	ViewData["Title"] = "Register User";
}
<style>
    body {
        font-family: 'Arial', sans-serif;
        background-color: #f9f9f9;
        margin: 0;
        padding: 0;
    }

    .container {
        margin-top: 50px;
    }

    .signup-form {
        background-color: #ffffff;
        border-radius: 10px;
        padding: 30px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }

    .signup-form h2 {
        font-size: 24px;
        font-weight: bold;
        color: #333333;
        margin-bottom: 20px;
        text-align: center;
    }

    .form-group label {
        font-size: 14px;
        font-weight: bold;
        color: #555555;
    }

    .form-control {
        border: 1px solid #cccccc;
        border-radius: 5px;
        padding: 10px;
        font-size: 14px;
        width: 100%;
        margin-bottom: 10px;
    }

    .btn {
        background-color: #5cb85c;
        color: #ffffff;
        padding: 10px 20px;
        font-size: 16px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .btn:hover {
        background-color: #4cae4c;
    }

    a {
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }

    a[style*="color: red;"] {
        font-weight: bold;
    }

    .text-danger {
        color: #d9534f;
    }

    p {
        text-align: center;
        margin-top: 10px;
    }

    p i {
        font-size: 14px;
        color: #606065;
    }


</style>

<section id="">
	<!--form-->
	<div class="container">
		<div class="row">
			<div class="col-sm-8 col-sm-offset-1">
				<div class="signup-form">
					<!--sign up form-->
					<h2>New User Signup!</h2>
					<div asp-validation-summary="ModelOnly" class="text-danger"></div>
					<form asp-action="Create" asp-controller="Account">
						<div class="form-group">
							<label>Username</label>
							<input asp-for="Username" class="form-control" />
							<span asp-validation-for="Username" class="text-danger" />
						</div>
						<div class="form-group">
							<label>Email</label>
							<input asp-for="Email" class="form-control" />
							<span asp-validation-for="Email" class="text-danger" />
						</div>
						<div class="form-group">
							<label>Password</label>
							<input asp-for="Password" class="form-control" />
							<span asp-validation-for="Password" class="text-danger" />
						</div>
						<div class="form-group">
							<label>Confirm Password</label>
							<input asp-for="ConfirmPassword" class="form-control" />
							<span asp-validation-for="ConfirmPassword" class="text-danger" />
						</div>
						<button class="btn btn-default">SignUp</button>
						<p style="margin-top: 20px; font-size: 16px;"><i style="color: #606065;">Bạn đã có tài khoản? </i> <a asp-action="Login" asp-controller="Account" style="color: red;">Đăng nhập</a></p>
					</form>
				</div><!--/sign up form-->
			</div>
		</div>
	</div>
</section><!--/form-->
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}