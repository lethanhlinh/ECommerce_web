@model IEnumerable<OrderModel>
@{
    ViewData["title"] = "List History Orders placed by " + " " + @ViewBag.UserEmail ;
}
<style>
    body {
        font-family: 'Arial', sans-serif;
        background-color: #f9f9f9;
        margin: 0;
        padding: 20px;
    }

    h3 {
        text-align: center;
        color: #333;
        margin-bottom: 20px;
        font-size: 24px;
        font-weight: bold;
    }

    table.table {
        width: 100%;
        margin: 0 auto;
        background-color: #fff;
        border-collapse: collapse;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    table.table th,
    table.table td {
        padding: 12px 15px;
        text-align: left;
        font-size: 14px;
        color: #555;
    }

    table.table th {
        background-color: #f4f4f4;
        font-weight: bold;
        color: #333;
    }

    table.table tr:nth-child(even) {
        background-color: #f9f9f9;
    }

    table.table tr:nth-child(odd) {
        background-color: #fff;
    }

    table.table tr:hover {
        background-color: #f1f1f1;
    }

    .btn {
        padding: 5px 10px;
        font-size: 12px;
        border-radius: 4px;
        text-decoration: none;
    }

    .btn-danger {
        background-color: #d9534f;
        color: white;
        border: none;
        cursor: pointer;
    }

    .btn-danger:hover {
        background-color: #c9302c;
    }

    .text-success {
        color: #5cb85c;
        font-weight: bold;
    }

    .text-primary {
        color: #0275d8;
        font-weight: bold;
    }

    .text-danger {
        color: #d9534f;
        font-weight: bold;
    }


</style>

<h3>List History Orders placed by @ViewBag.UserEmail </h3>

<table class="table" id="myTable">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Order Code</th>
            <th scope="col">Shipping Cost</th>
            <th scope="col">Coupon Code</th>
            <th scope="col">UserName</th>
            <th scope="col">Order Status</th>
            <th scope="col">Created Date</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th>#</th>
                <th> @item.OrderCode</th>
                <th> @item.ShippingCost.ToString("#,##0 VND")</th>
                <th> @item.CouponCode</th>
                <td>@item.UserName</td>
                <td>@item.CreateDate</td>

                <td>
                    @if (@item.Status == 1)
                    {
                        <span class="text text-success">Đơn hàng mới</span>
                    }
                    else if (@item.Status == 2)
                    {
                        <span class="text text-primary">Đã xữ lý</span>
                    }
                    else
                    {
                        <span class="text text-danger">Đã Hủy</span>
                    }
                </td>
                <td>@item.CreateDate.ToString("dd/MM/yyyy")</td>

                <td>
                    @if (@item.Status !=3)
                    {
                    <a asp-action="CancelOrder" asp-controller="Account" asp-route-ordercode="@item.OrderCode" class="btn btn-danger btn-sm">Cancel Order</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
