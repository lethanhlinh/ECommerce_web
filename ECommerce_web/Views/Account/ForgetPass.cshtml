@model AppUserModel
@{
	ViewData["Title"] = "Forget Password";
}
<section id="">
	<!--form-->
	<div class="container">
		<div class="row">
			<div class="col-sm-8 col-sm-offset-1">
				<div class="login-form">
					<!--login form-->
					<h2>Quên mật khẩu</h2>
					<div asp-validation-summary="ModelOnly" class="text-danger"></div>
					<form asp-action="SendMailForgotPass" asp-controller="Account">
						<div class="form-group">
							<label>Email</label>
							<input asp-for="Email" class="form-control" />
							<span asp-validation-for="Email" class="text-danger" />
						</div>
						
						<button class="btn btn-default">Send</button>
						<p style="margin-top: 20px; font-size: 16px;"><i style="color: #606065;">Bạn chưa có tài khoản? </i> <a asp-action="Create" asp-controller="Account" style="color: red;">Đăng ký</a></p>

					</form>
				</div><!--/login form-->
			</div>
		</div>
	</div>
</section><!--/form-->
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}