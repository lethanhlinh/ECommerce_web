@model LoginViewModel
@{
	ViewData["Title"] = "Login User";
}
<section id="">
	<!--form-->
	<div class="container">
		<div class="row">
			<div class="col-sm-8 col-sm-offset-1">
				<div class="login-form">
					<!--login form-->
					<h2>Login to your account</h2>
					<div asp-validation-summary="ModelOnly" class="text-danger"></div>
					<form asp-action="Login" asp-controller="Account">
						<div class="form-group">
							<label>Username</label>
							<input asp-for="Username" class="form-control" />
							<span asp-validation-for="Username" class="text-danger" />
						</div>
						<div class="form-group">
							<label>Password</label>
							<input asp-for="Password" class="form-control" />
							<span asp-validation-for="Password" class="text-danger" />
						</div>
						<a asp-action="ForgetPass" asp-controller="Account" style="color: red;">Quên mật khẩu</a>
						<button class="btn btn-default">Login</button>
						<a asp-action="LoginByGoogle" asp-controller="Account">Login By Google</a><br />
						<p style="margin-top: 20px; font-size: 16px;"><i style="color: #606065;">Bạn chưa có tài khoản? </i> <a asp-action="Create" asp-controller="Account" style="color: red;">Đăng ký</a></p>
						
					</form>
				</div><!--/login form-->
			</div>
		</div>
	</div>
</section><!--/form-->
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}