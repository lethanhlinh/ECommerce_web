@model IEnumerable<OrderModel>
@{
    ViewData["title"] = "Order Listed";
}
<h3>List Order</h3>

<table class="table" id="myTable">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Order Code</th>
            <th scope="col">Shipping Cost</th>
            <th scope="col">Coupon Code</th>
            <th scope="col">UserName</th>           
            <th scope="col">Created Time</th>
            <th scope="col">Status</th>
            <th scope="col">Created Date</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th>#</th>
                <th> @item.OrderCode</th>
                <th> @item.ShippingCost.ToString("#,##0 VND")</th>
                <th> @item.CouponCode</th>
                <td>@item.UserName</td>
                <td>@item.CreateDate</td>

                <td>
                    @if (@item.Status == 1)
                    {
                        <span class="text text-success">Đơn hàng mới</span>
                    }
                    else if (@item.Status == 2)
                    {
                        <span class="text text-primary">Đã xữ lý</span>
                    }
                    else
                    {
                        <span class="text text-danger">Đã Hủy</span>
                    }
                </td>
                <td>@item.CreateDate.ToString("dd/MM/yyyy")</td>

                <td>
                    <a asp-action="ViewOrder" asp-controller="Order" asp-route-ordercode="@item.OrderCode" class="btn btn-warning btn-sm">View Order</a>
                    <a asp-action="Delete" class="btn btn-danger btn-sm confirmDeletion" asp-controller="Order" asp-route-orderCode="@item.OrderCode">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
