@model IEnumerable<AppUserModel>
@{
    ViewData["title"] = "List User";
}
<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width"/>
        <title>Index</title>
    </head>
    <body>
    <h3>List User</h3>
<a asp-action="Create" asp-controller="User">Add User</a>
<table class="table">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">User Name</th>
            <th scope="col">Email</th>
            <th scope="col">PasswordHash</th>
            <th scope="col">Phone</th>
             <th scope="col">Role</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <th scope="row">@user.UserName</th>
                <td>@user.Email</td>
                    <td>@user.PasswordHash</td>
                <td>@user.PhoneNumber</td>

                <td>  </td>

                <td>
                    <a asp-action="Edit" asp-controller="User" asp-route-Id="@user.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" class="btn btn-danger btn-sm confirmDeletion" asp-controller="User" asp-route-Id="@user.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</body>
</html>