@model CouponModel
@{
	ViewData["title"] = "Create Coupon";
}
<h4>Create Coupon</h4>
<div class="col-md-9">
	<form asp-action="Create" autocomplete="off" asp-asp-controller="Coupon" enctype="multipart/form-data">
		<div asp-validation-summary="ModelOnly" class="text-danger"></div>
		<div class="form-group">
			<label>Name</label>
			<input asp-for="Name" class="form-control" />
			<span asp-validation-for="Name" class="text-danger" />
		</div>
		<div class="form-group">
			<label>Description</label>
			<textarea asp-for="Description" class="form-control"></textarea>
			<span asp-validation-for="Description" class="text-danger" />
		</div>
		
	
		<div class="form-group">
			<label>Date Start</label>
			<input asp-for="DateStart" class="form-control" />
			<span asp-validation-for="DateStart" class="text-danger" />
		</div>

		<div class="form-group">
			<label>Date Expired</label>
			<input asp-for="DateExpired" class="form-control" />
			<span asp-validation-for="DateExpired" class="text-danger" />
		</div>

		<div class="form-group">
			<label>Quantity</label>
			<input asp-for="Quantity" class="form-control" />
			<span asp-validation-for="Quantity" class="text-danger" />
		</div>

		<div class="form-group">
			<label>Status</label>
			<select asp-for="Status" class="form-control">
				<option value="1">Hiển thị</option>
				<option value="0">Ẩn</option>
			</select>
			<span asp-validation-for="Status" class="text-danger" />
		</div>
		<div class="form-group">
			<button class="btn btn-primary">Create</button>
		</div>
	</form>
	
	<h5>Danh sách mã giảm giá</h5>
	<table class="table table-striped" id="myTable">
		<thead>
			<tr>
				<th>Tên</th>
				<th>Mô tả</th>
				<th>Ngày bắt đầu</th>
				<th>Ngày hết hạn</th>
				<th>Số lượng</th>
				<th>Hiệu lực</th>
				<th>Trạng thái</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var coupon in ViewBag.Coupons) //lấy coupon_list từ controller
			{
				<tr>
					<td>@coupon.Name</td>
					<td>@coupon.Description</td>
					<td>@coupon.DateStart.ToString("dd-MM-yyyy")</td>
					<td>@coupon.DateExpired.ToString("dd-MM-yyyy")</td>
					<td>@coupon.Quantity</td>
					<td>
						@if (coupon.Status == 1) //kích hoạt
						{
							<select name="Status">
								<option value="1">Kích hoạt</option>
								<option selected value="0">Ẩn</option>
							</select>
						}
					</td>

					<td>
						@if(coupon.DateExpired < DateTime.Now) //nếu ngày hết hạn nhỏ hơn ngày hiện tại thì hiển thị hết hạn
						{
							<span class="text text-danger">Hết hạn</span>
						}
						else
						{
							TimeSpan remainingTime = coupon.DateExpired - DateTime.Now;
							int daysRemaining = remainingTime.Days; //Tính toán số ngày còn lại của mã giảm giá
							@if (daysRemaining == 1)
							{
								<span class="text-area text-danger">Hết hạn hôm nay</span>
							}
							else
							{
								<span class="text text-success">@daysRemaining ngày còn lại</span> //Hiển thị số ngày còn lại của mã giảm giá
							}
						}
					</td>
				</tr>
			}
		</tbody>
	</table>

</div>
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
